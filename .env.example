# Copy to .env (gitignored) and fill in. Never commit real values.
DEALSOURCE_DATA_DIR=private
CENSUS_API_KEY=
SAM_API_KEY=
SAM_DAILY_REQUEST_BUDGET=8
DEALSOURCE_USER_AGENT_CONTACT=
DEALSOURCE_SOURCE_PRIORITY=csv
OLLAMA_HOST=http://127.0.0.1:11434
LLM_BACKEND=ollama
LLM_MODEL=qwen2.5:7b
# DEALSOURCE_ALLOW_REMOTE_LLM=1   # only to allow a non-local OLLAMA_HOST; off by default
FETCH_MIN_DELAY_SECONDS=2.0
FETCH_MAX_PAGES_PER_SITE=5
